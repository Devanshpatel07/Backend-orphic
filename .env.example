# ======================================================
# Employee Management System — Environment Variables
# ======================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.

# Database (Option 1: Individual Parameters)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=employee_management
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Database (Option 2: Cloud Database URL for Render / Railway / Aiven / etc.)
# DATABASE_URL=mysql://username:password@hostname:3306/employee_management
# SPRING_DATASOURCE_URL=jdbc:mysql://hostname:3306/employee_management?serverTimezone=UTC&allowPublicKeyRetrieval=true

# JWT — must be base64-encoded string of at least 256 bits (32 chars raw)
# Generate with: echo -n "your-256-bit-secret" | base64
JWT_SECRET=c2VjdXJlLWp3dC1zZWNyZXQta2V5LWZvci1lbXBsb3llZS1tYW5hZ2VtZW50LXN5c3RlbS0yMDI2
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Server
PORT=8080
SPRING_PROFILE=dev
